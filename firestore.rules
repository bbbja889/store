rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // App Validation
    function isValidApp(data) {
      return data.keys().hasAll(['slug', 'name', 'tagline', 'description', 'developer_id', 'developer_name']) &&
             data.developer_id == request.auth.uid;
    }

    // Website Validation
    function isValidWebsite(data) {
      return data.keys().hasAll(['slug', 'name', 'tagline', 'description', 'url', 'developer_id', 'developer_name']) &&
             data.developer_id == request.auth.uid;
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /apps/{appId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidApp(request.resource.data);
      allow update: if isAuthenticated() && isOwner(resource.data.developer_id) && isValidApp(request.resource.data);
      allow delete: if isAuthenticated() && isOwner(resource.data.developer_id);
    }

    match /websites/{websiteId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidWebsite(request.resource.data);
      allow update: if isAuthenticated() && isOwner(resource.data.developer_id) && isValidWebsite(request.resource.data);
      allow delete: if isAuthenticated() && isOwner(resource.data.developer_id);
    }
  }
}
